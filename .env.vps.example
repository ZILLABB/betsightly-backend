# COPY to .env.vps ONLY on the VPS / secrets manager, never commit actual values.
# Configure values through the intended deployment environment; the GitHub
# workflow uses this file only as nonproduction syntax-validation input.
ENVIRONMENT=production
DEBUG=False
DATABASE_URL=postgresql://example:change-me@db.internal.example:5432/betsightly?sslmode=require
SECRET_KEY=replace-with-random-long-secret
API_KEY=replace-with-strong-api-key
ADMIN_PASSWORD_HASH=replace-with-pbkdf2-hash
ALLOWED_ORIGINS=https://betsightly.com,https://www.betsightly.com
ALLOWED_HOSTS=betsightly.com,www.betsightly.com
API_FOOTBALL_API_KEY=
FOOTBALL_DATA_KEY=
ODDS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_GROUP_ID=
SENTRY_DSN=
SETTLEMENT_POLL_SECONDS=60
SETTLEMENT_FULL_POLL_SECONDS=900
SETTLEMENT_FALLBACK_SECONDS=3600

# Never enable until former Render writers and Telegram polling are fenced.
# Must be set manually for each approved cutover to enable dedicated VPS roles.
BETSIGHTLY_VPS_WRITER_ACTIVATION=disabled

# Set true by Compose on the VPS; enforces a successful database connection.
# Do not set this on the existing Render deployment.
BETSIGHTLY_VPS_REQUIRE_DB=false
