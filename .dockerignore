# for ML feature computation. Kept in the image.

# Large model files not tracked by git anyway
models/api_football/*_rf.joblib
models/api_football/*_et.joblib
catboost_info/

# Local DB (production uses PostgreSQL)
*.db
*.sqlite3
*.db-shm
*.db-wal

# Env file (use Render dashboard for env vars)
.env

# Docs / tests
tests/
docs/
*.md
LICENSE

# Temp
cache/
check_db.py
