# ML models — keep small efficient models, ignore large tree ensembles
# Random Forest and Extra Trees models are 40-70MB each (too large for git)
# They are regenerated by: py scripts/retrain_models.py
models/api_football/*_rf.joblib
models/api_football/*_et.joblib
catboost_info/

# Data files (optional, depending on your strategy)
# data/

# Temporary files
.DS_Store
Thumbs.db
cache/

# SQLite WAL/SHM sidecar files
*.db-shm
*.db-wal
*.corrupt-backup

# Rebuildable runtime caches under leagues/data — regenerated from ESPN and
# from the settled record on first use. Committing them means a deploy ships a
# stale snapshot of match history and calibration.
leagues/data/team_history.json
leagues/data/calibration_fit.json
leagues/data/shopped_odds.json
